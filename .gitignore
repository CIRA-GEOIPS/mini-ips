# Generated by prune/slim.py. Never edit by hand and never commit: the whole
# design is that this is reproducible from upstream.lock + prune/ + overlay/.
/build/

# Local bare mirror of upstream, created by slim.py when no --upstream-path is
# given.
/.upstream-cache.git/

# A convenience clone of upstream for local iteration (slim.py picks it up
# automatically as --upstream-path). 385 MB; not part of the fork. NOT named
# "geoips": a sibling of that name shadows the installed package as a namespace
# package, and every tool run from the repo root imports it by mistake.
/upstream-geoips/

__pycache__/
*.py[cod]
.venv/
/.pytest_cache/
/*.json
/*.log
